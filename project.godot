; Engine configuration file.
; Godot 4.2+ project - DeadRails Desert Survival Clone
; Web-optimized with mobile touch support

config_version=5

[application]

config/name="DeadRails Desert Survival"
config/description="Top-down desert survival inspired by Deadrails - camel caravan roguelite"
run/main_scene="res://scenes/Stable.tscn"
config/features=PackedStringArray("4.2", "Web")

[autoload]

GameManager="*res://scripts/global.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input]

